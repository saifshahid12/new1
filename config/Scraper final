    def _extract_date_for_sorting(self, timestamp):
        if not timestamp: return None
        try:
            if "ago" in timestamp.lower():
                return self._parse_relative_date(timestamp)
            from datetime import datetime
            return datetime.now() # Fallback
        except: return None

    def _parse_relative_date(self, text):
        from datetime import datetime, timedelta
        import re
        now = datetime.now()
        match = re.search(r'(\d+)\s+(minute|hour|day|week)', text)
        if match:
            val = int(match.group(1))
            unit = match.group(2)
            if 'minute' in unit: return now - timedelta(minutes=val)
            if 'hour' in unit: return now - timedelta(hours=val)
            if 'day' in unit: return now - timedelta(days=val)
            if 'week' in unit: return now - timedelta(weeks=val)
        return now

    def sort_posts_by_date(self, posts, order="latest"):
        if order == "none": return posts
        # Simple sort based on date object if present
        def get_date(x): return x.get('Date_For_Sorting') or 0
        posts.sort(key=get_date, reverse=(order == "latest"))
        return posts

