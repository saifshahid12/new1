    def _human_typing(self, element, text):
        element.clear()
        for char in text:
            element.send_keys(char)
            time.sleep(random.uniform(0.05, 0.15))

    def _human_mouse_movement(self, element=None, moves=1):
        # Basic implementation to satisfy calls
        try:
            action = ActionChains(self.driver)
            if element:
                action.move_to_element(element).perform()
            else:
                action.move_by_offset(10, 10).perform()
        except: pass

    def _random_human_action(self):
        time.sleep(random.uniform(0.5, 1.5))

    def _random_human_mouse_move(self):
        self._human_mouse_movement(moves=1)

