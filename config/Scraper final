class LinkedInScraper:
    """
    LinkedInScraper is a Selenium-based tool for extracting posts from LinkedIn
    while mimicking human behavior to avoid bot detection.
    """
    CATEGORY_URL_MAP = {
        "Posts": "/search/content/",
        "Jobs": "/search/jobs/",
        "People": "/search/people/",
        "Companies": "/search/companies/"
    }

    # --- CONSTANTS ---
    LOGIN_USERNAME_FIELD = (By.NAME, 'session_key')
    LOGIN_PASSWORD_FIELD = (By.NAME, 'session_password')
    LOGIN_SUBMIT_BUTTON = (By.XPATH, "//button[@type='submit']")
    SEARCH_INPUT_FIELD = (By.CSS_SELECTOR, 'input.search-global-typeahead__input')
    
    # Combined container for Feed Posts and Job Cards
    POST_CONTAINER = (By.XPATH, "//div[contains(@class, 'job-card-container')] | //div[contains(@class, 'feed-shared-update-v2')]")
    
    # Standard Post Selectors
    POST_TEXT_CONTENT = (By.XPATH, ".//div[contains(@class, 'update-components-text')]//span[@dir='ltr']")
    POST_AUTHOR_NAME = (By.XPATH, ".//span[@dir='ltr']/span[@aria-hidden='true']")
    
    def __init__(self, config, init_driver=True):
        self.config = config
        self.driver = None
        self.scraped_data = []
        self.username, self.password = load_credentials()
        self.search_query = config['scraper_settings'].get('search_query', '')
        self.category = config['scraper_settings'].get('category', 'Posts')
        self._validate_config()

        if init_driver:
            self._setup_driver()

    def _validate_config(self):
        logging.info("Validating configuration parameters...")
        if 'scraper_settings' not in self.config:
            raise ValueError("CRITICAL: Missing 'scraper_settings' in config")
        if not self.username or not self.password:
            raise ValueError("LinkedIn credentials not loaded from .env file")
        logging.info("Configuration validation complete.")

    def _setup_driver(self):
        logging.info("Setting up Chrome WebDriver...")
        service = ChromeService(ChromeDriverManager().install())
        options = webdriver.ChromeOptions()
        options.add_argument("--start-maximized")
        options.add_argument("--disable-notifications")
        options.add_argument("--disable-blink-features=AutomationControlled")
        options.add_experimental_option("excludeSwitches", ["enable-automation"])
        options.add_experimental_option("useAutomationExtension", False)
        
        proxy_config = self.config.get("proxy", {})
        if proxy_config.get("enabled") and proxy_config.get("host"):
            options.add_argument(f"--proxy-server=http://{proxy_config['host']}:{proxy_config['port']}")

        self.driver = webdriver.Chrome(service=service, options=options)
        self.driver.execute_script("Object.defineProperty(navigator, 'webdriver', {get: () => undefined})")

    def close(self):
        if self.driver:
            self.driver.quit()
            self.driver = None
            logging.info("Browser session closed.")

    def _random_delay(self, min_time: float = None, max_time: float = None):
        if min_time is None or max_time is None:
            settings = self.config['scraper_settings'].get('delay', {'min_sec': 1.0, 'max_sec': 3.0})
            min_sec = settings['min_sec']
            max_sec = settings['max_sec']
        else:
            min_sec, max_sec = min_time, max_time
        time.sleep(random.uniform(min_sec, max_sec))

    def login(self):
        url = self.config['scraper_settings']['base_url']
        logging.info(f"Navigating to login page: {url}")
        self.driver.get(url)
        self._random_delay(2, 3)

        try:
            wait = WebDriverWait(self.driver, 20)
            username_field = wait.until(EC.presence_of_element_located(self.LOGIN_USERNAME_FIELD))
            self._human_typing(username_field, self.username)
            self._random_delay(1, 2)

            password_field = wait.until(EC.presence_of_element_located(self.LOGIN_PASSWORD_FIELD))
            self._human_typing(password_field, self.password)
            self._random_delay(1, 2)

            submit_button = wait.until(EC.element_to_be_clickable(self.LOGIN_SUBMIT_BUTTON))
            submit_button.click()
            logging.info("Login credentials submitted.")
            self._random_delay(5, 8)
            
            try:
                wait.until(EC.presence_of_element_located(self.SEARCH_INPUT_FIELD))
                logging.info("Login successful.")
            except:
                logging.warning("Search bar not found instantly, continuing anyway...")

        except Exception as e:
            logging.error(f"Login failed: {e}")
            raise

    def perform_search(self):
        logging.info(f"Executing search for query: '{self.search_query}'")
        try:
            search_box = WebDriverWait(self.driver, 20).until(
                EC.presence_of_element_located((By.XPATH, "//input[contains(@placeholder,'Search')]"))
            )
            search_box.clear()
            search_box.send_keys(self.search_query)
            search_box.send_keys(Keys.ENTER)
            logging.info("Search submitted.")
            self._random_delay(3, 5)
        except Exception as e:
            logging.error(f"Search failed: {e}")
            raise

    # =====================================================================================
    #  SCROLLING LOGIC (UPDATED FOR CONTINUOUS SCROLL)
    # =====================================================================================
    def human_like_scroll(self):
        try:
            scroll_limit = self.config['scraper_settings']['scroll_limit']
            is_jobs = self.category.lower() == "jobs"
            
            jobs_container = None
            if is_jobs:
                logging.info("Looking for Jobs Sidebar...")
                selectors = [
                    "//div[contains(@class, 'jobs-search-results-list')]",
                    "//div[contains(@class, 'scaffold-layout__list')]",
                    "//div[contains(@class, 'jobs-search-results')]" 
                ]
                for xpath in selectors:
                    try:
                        elem = self.driver.find_element(By.XPATH, xpath)
                        if elem.is_displayed():
                            jobs_container = elem
                            logging.info(f"Jobs Sidebar Found: {xpath}")
                            ActionChains(self.driver).move_to_element(jobs_container).perform()
                            break
                    except:
                        continue
            
            # Initial Height
            if jobs_container:
                last_height = self.driver.execute_script("return arguments[0].scrollHeight", jobs_container)
            else:
                last_height = self.driver.execute_script("return document.body.scrollHeight")

            scroll_count = 0
            attempts = 0
            
            logging.info(f"Starting scroll loop (Limit: {scroll_limit})")
            
            while scroll_count < scroll_limit:
                
                # Scroll Logic
                if is_jobs and jobs_container:
                    # Scroll to bottom of container
                    self.driver.execute_script("arguments[0].scrollTop = arguments[0].scrollHeight", jobs_container)
                else:
                    self.driver.execute_script("window.scrollTo(0, document.body.scrollHeight);")
                
                self._random_delay(3.0, 5.0) # Wait for content load
                
                # Check New Height
                if jobs_container:
                    new_height = self.driver.execute_script("return arguments[0].scrollHeight", jobs_container)
                else:
                    new_height = self.driver.execute_script("return document.body.scrollHeight")
                
                if new_height == last_height:
                    attempts += 1
                    if attempts >= 3:
                        logging.info("No new content loaded after multiple attempts.")
                        break
                else:
                    attempts = 0
                    last_height = new_height
                    scroll_count += 1
                    logging.info(f"Scrolled {scroll_count}/{scroll_limit}")

            logging.info("Scrolling finished.")

        except Exception as e:
            logging.error(f"Scrolling error: {e}")

    # =====================================================================================
    #  EXTRACTION LOGIC (UPDATED FOR DATA PARSING)
    # =====================================================================================
    def extract_post_elements(self):
        logging.info("Starting extraction...")
        
        try:
            WebDriverWait(self.driver, 5).until(EC.presence_of_element_located(self.POST_CONTAINER))
        except:
            pass

        post_elements = self.driver.find_elements(*self.POST_CONTAINER)
        logging.info(f"Found {len(post_elements)} raw items.")
        
        selected_category = getattr(self, "category", "Posts")
        
        for i, element in enumerate(post_elements[:150]):
            try:
                # Ensure element is in view to get text
                self.driver.execute_script("arguments[0].scrollIntoView({block: 'center'});", element)
                
                data = self._parse_single_post(element)
                data['Category'] = selected_category
                if 'category' in data: del data['category']
                
                if not self._is_duplicate(data):
                    self.scraped_data.append(data)
            except:
                continue
                
        logging.info(f"Extraction complete. Total unique items: {len(self.scraped_data)}")
        return self.scraped_data

    def _parse_single_post(self, element) -> dict:
        data = {
            'Post Text': "[No Text]", 
            'Author Name': "[No Author]", 
            'Timestamp': "[No Time]", 
            'Post URL': "[No URL]",
            'Date_For_Sorting': None
        }
        
        # --- JOB SPECIFIC PARSING ---
        if self.category.lower() == "jobs":
            # 1. Job Title (Post Text)
            try:
                title = element.find_element(By.CSS_SELECTOR, "strong, .job-card-list__title, .artdeco-entity-lockup__title")
                data['Post Text'] = title.text.strip()
            except:
                try: data['Post Text'] = element.text.split('\n')[0]
                except: pass

            # 2. Company Name (Author)
            try:
                comp = element.find_element(By.CSS_SELECTOR, ".job-card-container__primary-description, .artdeco-entity-lockup__subtitle")
                data['Author Name'] = comp.text.strip()
            except: pass

            # 3. Location/Metadata (Timestamp replacement)
            try:
                meta = element.find_element(By.CSS_SELECTOR, ".job-card-container__metadata-item")
                data['Timestamp'] = meta.text.strip()
            except: pass
            
        # --- POST SPECIFIC PARSING ---
        else:
            try:
                text_el = element.find_element(*self.POST_TEXT_CONTENT)
                data['Post Text'] = text_el.text.strip()
            except: pass
            
            try:
                auth_el = element.find_element(*self.POST_AUTHOR_NAME)
                data['Author Name'] = auth_el.text.strip()
            except: pass
            
            try:
                time_el = element.find_element(By.TAG_NAME, "time")
                data['Timestamp'] = time_el.text.strip()
            except: pass

        # --- SHARED: URL Extraction ---
        try:
            link = element.find_element(By.TAG_NAME, "a")
            href = link.get_attribute("href")
            if href: data['Post URL'] = href.split('?')[0]
        except: pass
        
        # --- DATE SORTING ---
        data['Date_For_Sorting'] = self._extract_date_for_sorting(data['Timestamp'])

        return data

    def _is_duplicate(self, new_post):
        for p in self.scraped_data:
            if p['Post URL'] != "[No URL]" and p['Post URL'] == new_post['Post URL']:
                return True
            # Fallback for jobs with no URL but same title + company
            if (p['Post Text'] == new_post['Post Text'] and 
                p['Author Name'] == new_post['Author Name']):
                return True
        return False

