def _parse_single_post(self, post_element) -> dict:
        """
        Parses a single LinkedIn post element.
        UPDATED: Expands text to capture hidden emails and extracts metadata reliably.
        """

        # Initialize data structure
        post_data = {
            'Post Text': None,
            'Author Name': "[Unknown Author]",
            'Timestamp': "[Unknown Time]",
            'Post URL': "[No URL Found]",
            'Category': getattr(self, 'category', 'Posts'),
            'Date_For_Sorting': None
        }

        try:
            # ==================================================================
            # 1. CLICK "SEE MORE" (Crucial for hidden emails)
            # ==================================================================
            try:
                # Try finding the button by text content (most reliable for English LinkedIn)
                see_more_button = post_element.find_element(By.XPATH, ".//button[contains(text(), 'see more')]")
                if see_more_button.is_displayed():
                    self.driver.execute_script("arguments[0].click();", see_more_button)
                    self._random_delay(0.5, 1.0) # Wait slightly for text to expand
            except:
                pass # If button doesn't exist, just continue

            # ==================================================================
            # 2. EXTRACT FULL TEXT (The Fix for Missing Emails)
            # ==================================================================
            # Instead of looking for a specific class, get ALL text visible in the post card.
            # This ensures we capture emails in the header, body, or footer.
            full_text = post_element.text.strip()
            
            if full_text:
                post_data['Post Text'] = full_text
            else:
                post_data['Post Text'] = "[No Text Content Found]"

            # ==================================================================
            # 3. EXTRACT METADATA (Author, Time, URL)
            # ==================================================================
            
            # --- Author Name ---
            try:
                # Look for the actor title class
                author_elem = post_element.find_element(By.XPATH, ".//span[contains(@class, 'update-components-actor__title') or contains(@class, 'feed-shared-actor__title')]")
                # Split by newline to remove any extra badge text (like '• 1st')
                post_data['Author Name'] = author_elem.text.split('\n')[0].strip()
            except:
                pass # Keep default [Unknown Author]

            # --- Timestamp ---
            try:
                # Strategy 1: Look for the specific time link/text
                time_elem = post_element.find_element(By.XPATH, ".//a[contains(@class, 'update-components-actor__sub-description') or contains(@href, 'activity')]//span[not(@class)]")
                time_text = time_elem.text.strip()
                # Clean up text (remove '• Edited')
                if time_text:
                    post_data['Timestamp'] = time_text.split('•')[0].strip()
            except:
                # Strategy 2: Look for 'ago' text
                try:
                    ago_elem = post_element.find_element(By.XPATH, ".//*[contains(text(), 'ago')]")
                    post_data['Timestamp'] = ago_elem.text.strip()
                except:
                    pass

            # --- Post URL ---
            try:
                # Strategy 1: Get data-urn (Best/Cleanest)
                urn = post_element.get_attribute("data-urn")
                if urn:
                    # urn format: urn:li:activity:7123456...
                    activity_id = urn.split(":")[-1]
                    post_data['Post URL'] = f"https://www.linkedin.com/feed/update/urn:li:activity:{activity_id}/"
                else:
                    # Strategy 2: Find the anchor tag linking to the activity
                    link_elem = post_element.find_element(By.XPATH, ".//a[contains(@href, 'activity') or contains(@href, 'urn:li:activity')]")
                    href = link_elem.get_attribute("href")
                    if href:
                        post_data['Post URL'] = href.split('?')[0]
            except:
                pass

            # --- Date Sorting Helper ---
            post_data['Date_For_Sorting'] = self._extract_date_for_sorting(post_data['Timestamp'])

        except Exception as e:
            logging.debug(f"Error extracting post data: {e}")

        return post_data
