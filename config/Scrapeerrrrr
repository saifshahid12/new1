            try:
                current_url = self.driver.current_url
                show_results = WebDriverWait(self.driver, 10).until(
                    EC.element_to_be_clickable((By.XPATH, "//button[contains(., 'Show') and contains(., 'result')]"))
                )
                self.driver.execute_script("arguments[0].click();", show_results)
                
                # Wait for reload
                try:
                    WebDriverWait(self.driver, 15).until(lambda d: d.current_url != current_url)
                except: pass
                
                self._random_delay(3, 5)
                self.driver.execute_script("window.scrollTo(0, 0);")
                
            except Exception as e:
                logging.error(f"Failed to click Show results: {e}")
        
        except Exception as e:
            logging.error(f"Filter error: {e}")

    def _get_sort_text_for_category(self, category: str, sort_order: str) -> str:
        """Returns the correct text for sorting based on the category."""
        sort_mappings = {
            "Posts": {"latest": "Latest", "oldest": "Top match"},
            "Jobs": {"latest": "Most recent", "oldest": "Most relevant"},
            "People": {"latest": "Recently added", "oldest": "Most relevant"},
            "Companies": {"latest": "Most recent", "oldest": "Most relevant"}
        }
        cat_map = sort_mappings.get(category, sort_mappings["Posts"])
        return cat_map.get(sort_order.lower(), cat_map["latest"])

    def _extract_date_for_sorting(self, timestamp: str):
        """Helper to convert timestamp text to datetime object."""
        if not timestamp or timestamp == "[Unknown Time]":
            return None
        try:
            if "ago" in timestamp.lower():
                return self._parse_relative_date(timestamp)
            # Fallback for now if parsing fails
            return datetime.now()
        except: return None

    def _parse_relative_date(self, relative_time: str):
        """Parses '2 days ago' into a datetime object."""
        from datetime import datetime, timedelta
        import re
        now = datetime.now()
        pattern = r'(\d+)\s+(day|week|hour|minute|month|year)s?\s+ago'
        match = re.search(pattern, relative_time.lower())
        if match:
            amount = int(match.group(1))
            unit = match.group(2)
            if unit == "day": return now - timedelta(days=amount)
            elif unit == "week": return now - timedelta(weeks=amount)
            elif unit == "month": return now - timedelta(days=30*amount)
            elif unit == "year": return now - timedelta(days=365*amount)
            elif unit == "hour": return now - timedelta(hours=amount)
            elif unit == "minute": return now - timedelta(minutes=amount)
        return None

    def sort_posts_by_date(self, posts: list, sort_order: str = "latest"):
        """Sorts the extracted posts based on the parsed date."""
        if sort_order.lower() == "none":
            return posts
        posts_with_dates = []
        posts_without_dates = []
        for post in posts:
            if post.get('Date_For_Sorting'):
                posts_with_dates.append(post)
            else:
                posts_without_dates.append(post)
        reverse_order = (sort_order.lower() == "latest")
        posts_with_dates.sort(key=lambda x: x['Date_For_Sorting'], reverse=reverse_order)
        return posts_with_dates + posts_without_dates
