    def _parse_single_post(self, element) -> dict:
        """
        Parses a single element (Post or Job Card) into a structured dictionary.
        Handles different DOM structures for 'Jobs' vs 'Posts'.
        """
        
        post_data = {
            'Post Text': "[No Text]", 
            'Author Name': "[No Author]", 
            'Timestamp': "[No Time]", 
            'Post URL': "[No URL]",
            'Category': getattr(self, 'category', 'Posts'),
            'Date_For_Sorting': None
        }

        # --- LOGIC FOR JOBS CATEGORY ---
        if self.category.lower() == "jobs":
            # 1. Job Title (stored as Post Text)
            try:
                # Try finding the strong tag or job title class
                title_elem = element.find_element(By.CSS_SELECTOR, "strong, .job-card-list__title, .artdeco-entity-lockup__title")
                post_data['Post Text'] = title_elem.text.strip()
            except:
                try:
                    # Fallback: Split text by newline
                    post_data['Post Text'] = element.text.split('\n')[0]
                except: pass

            # 2. Company Name (stored as Author Name)
            try:
                company_elem = element.find_element(By.CSS_SELECTOR, ".job-card-container__primary-description, .artdeco-entity-lockup__subtitle")
                post_data['Author Name'] = company_elem.text.strip()
            except: pass

            # 3. Location/Metadata (stored as Timestamp replacement)
            try:
                meta_elem = element.find_element(By.CSS_SELECTOR, ".job-card-container__metadata-item")
                post_data['Timestamp'] = meta_elem.text.strip()
            except: pass
            
        # --- LOGIC FOR STANDARD POSTS ---
        else:
            # Expand "see more" if available
            try:
                see_more = element.find_element(By.XPATH, ".//button[contains(text(), 'see more')]")
                self.driver.execute_script("arguments[0].click();", see_more)
                time.sleep(0.5)
            except: pass

            # Extract Text
            try:
                text_elem = element.find_element(*self.POST_TEXT_CONTENT)
                post_data['Post Text'] = text_elem.text.strip()
            except: pass
            
            # Extract Author
            try:
                author_elem = element.find_element(*self.POST_AUTHOR_NAME)
                post_data['Author Name'] = author_elem.text.strip()
            except: pass
            
            # Extract Time
            try:
                time_elem = element.find_element(By.TAG_NAME, "time")
                post_data['Timestamp'] = time_elem.text.strip()
            except: pass

        # --- SHARED: URL Extraction ---
        try:
            link_elem = element.find_element(By.TAG_NAME, "a")
            href = link_elem.get_attribute("href")
            if href:
                post_data['Post URL'] = href.split('?')[0]
        except: pass
        
        # --- DATE SORTING HELPER ---
        post_data['Date_For_Sorting'] = self._extract_date_for_sorting(post_data['Timestamp'])

        return post_data

    # =============================================================================

    def _is_duplicate(self, post_data: dict) -> bool:
        """Checks if a post/job is already scraped to avoid duplicates."""
        
        # Check by URL first (most reliable)
        if post_data.get('Post URL') and post_data['Post URL'] != "[No URL]":
            for existing_post in self.scraped_data:
                if existing_post.get('Post URL') == post_data['Post URL']:
                    return True
            
        # Fallback: Check by Title + Company (useful for Jobs where URL might be hidden/dynamic)
        if post_data.get('Post Text') and post_data['Post Text'] != "[No Text]":
            for existing_post in self.scraped_data:
                if (existing_post.get('Post Text') == post_data.get('Post Text') and
                    existing_post.get('Author Name') == post_data.get('Author Name')):
                    return True
                    
        return False

