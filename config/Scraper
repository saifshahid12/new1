    def _parse_single_post(self, post_element) -> dict:
        """Parses a single element (Post or Job Card)."""
        
        post_data = {
            'Post Text': None,
            'Author Name': None,
            'Timestamp': None,
            'Post URL': None,
            'Category': getattr(self, 'category', 'Posts'),
            'Date_For_Sorting': None
        }

        # 1. Extract Text / Job Title
        try:
            # For Posts
            text_element = post_element.find_element(*self.POST_TEXT_CONTENT)
            post_data['Post Text'] = text_element.text.strip()
        except:
            # For Jobs (Job Title)
            try:
                title_elem = post_element.find_element(By.XPATH, ".//strong") # Often job title is strong
                post_data['Post Text'] = title_elem.text.strip() # Using Job Title as 'Post Text'
            except:
                try:
                    # Fallback for job title
                    title_elem = post_element.find_element(By.CLASS_NAME, "job-card-list__title")
                    post_data['Post Text'] = title_elem.text.strip()
                except:
                    post_data['Post Text'] = "[No Text/Title Found]"

        # 2. Extract Author / Company Name
        try:
            author_element = post_element.find_element(*self.POST_AUTHOR_NAME)
            post_data['Author Name'] = author_element.text.strip()
        except:
            # For Jobs (Company Name)
            try:
                company_elem = post_element.find_element(By.CLASS_NAME, "job-card-container__primary-description")
                post_data['Author Name'] = company_elem.text.strip()
            except:
                post_data['Author Name'] = "[Unknown Author/Company]"

        # 3. Extract Timestamp / Location
        try:
            time_elem = post_element.find_element(By.TAG_NAME, "time")
            post_data['Timestamp'] = time_elem.text.strip()
        except:
            # If no time, maybe get location for jobs
            try:
                loc_elem = post_element.find_element(By.CLASS_NAME, "job-card-container__metadata-item")
                post_data['Timestamp'] = loc_elem.text.strip() # Storing location/metadata as timestamp fallback
            except:
                post_data['Timestamp'] = "[Unknown Time]"
        
        post_data['Date_For_Sorting'] = self._extract_date_for_sorting(post_data['Timestamp'])

        # 4. Extract URL
        try:
            # For jobs, the link is usually on the title
            link_elem = post_element.find_element(By.TAG_NAME, "a")
            href = link_elem.get_attribute("href")
            if href:
                post_data['Post URL'] = href.split("?")[0]
            else:
                post_data['Post URL'] = "[No URL]"
        except:
             post_data['Post URL'] = "[No URL]"

        return post_data

    # =============================================================================

    def _is_duplicate(self, post_data: dict) -> bool:
        """Checks if a post is already scraped."""
        if post_data.get('Post URL') and post_data['Post URL'] != "[No URL]":
            for existing_post in self.scraped_data:
                if existing_post.get('Post URL') == post_data['Post URL']:
                    return True
            return False
        
        # Fallback to text matching
        for existing in self.scraped_data:
            if (existing.get('Post Text') == post_data.get('Post Text') and 
                existing.get('Author Name') == post_data.get('Author Name')):
                return True
        return False

