    def extract_post_elements(self):
        """Extracts posts/jobs from the loaded page."""
        logging.info("Starting extraction...")

        try:
            # General wait for any item
            WebDriverWait(self.driver, 5).until(EC.presence_of_element_located(self.POST_CONTAINER))
        except:
             pass # Continue to try finding elements

        # Find elements
        post_elements = self.driver.find_elements(*self.POST_CONTAINER)
        
        # If looking for jobs specifically, try job card class
        if self.category.lower() == "jobs" and len(post_elements) == 0:
             post_elements = self.driver.find_elements(By.CLASS_NAME, "job-card-container")

        logging.info(f"Found {len(post_elements)} items.")
        selected_category = getattr(self, "category", "Posts")

        for i, post_element in enumerate(post_elements[:100]): # Limit to 100
            try:
                post_data = self._parse_single_post(post_element)
                post_data['Category'] = selected_category
                
                if 'category' in post_data: del post_data['category']

                if not self._is_duplicate(post_data):
                    self.scraped_data.append(post_data)
                    logging.debug(f"Item {i+1} added.")
            except Exception as e:
                continue
        
        logging.info(f"Extraction complete. Total unique items: {len(self.scraped_data)}")
        return self.scraped_data

