    def human_like_scroll(self):
        """Simulates continuous scrolling to load more content.
           Updated to handle 'Jobs' category split-view scrolling.
        """
        try:
            # select scroll limit from config file 
            scroll_limit = self.config['scraper_settings']['scroll_limit']
            # select max scroll attempts from config 
            max_attempts = self.config['scraper_settings'].get('max_scroll_attempts', 50)

            # CHECK IF CATEGORY IS JOBS
            is_jobs_category = self.category.lower() == "jobs"
            jobs_scrollable_container = None

            if is_jobs_category:
                logging.info("Category is 'Jobs'. Identifying scrollable container...")
                try:
                    # Try to find the specific scrollable div for jobs
                    # Common classes: jobs-search-results-list, jobs-search-results__list, scaffold-layout__list
                    possible_selectors = [
                        "//div[contains(@class, 'jobs-search-results-list')]",
                        "//div[contains(@class, 'jobs-search-results__list')]",
                        "//div[contains(@class, 'scaffold-layout__list-container')]",
                        "//ul[contains(@class, 'jobs-search-results__list')]" # sometimes it's the UL
                    ]
                    
                    for xpath in possible_selectors:
                        try:
                            element = self.driver.find_element(By.XPATH, xpath)
                            if element.is_displayed():
                                jobs_scrollable_container = element
                                logging.info(f"Jobs scrollable container found with xpath: {xpath}")
                                break
                        except:
                            continue
                    
                    if not jobs_scrollable_container:
                        logging.warning("Could not identify specific Jobs container. Fallback to body scroll.")
                        is_jobs_category = False # Fallback to normal scroll
                except Exception as e:
                    logging.warning(f"Error finding job container: {e}. Fallback to normal scroll.")
                    is_jobs_category = False

            # Get Initial Height
            if is_jobs_category and jobs_scrollable_container:
                last_height = self.driver.execute_script("return arguments[0].scrollHeight", jobs_scrollable_container)
            else:
                last_height = self.driver.execute_script("return document.body.scrollHeight")

            # add how much time count scroll (mention in config)
            scroll_count = 0
            # add attempts how much time attempts (mention in config)
            attempts = 0

            # logging info when all is okay 
            logging.info(f"Starting human-like scrolling (limit: {scroll_limit})...")

            # use while loop for all scrolling process
            while scroll_count < scroll_limit and attempts < max_attempts:

                # use if condition like a human scroll 
                if random.random() < 0.3:
                    self._random_human_action()

                # use for random mouse move 
                self._random_human_mouse_move()
                self._random_delay(2, 3)
                self._human_presence()

                # random scroll time 
                scroll_by = random.randint(700, 1500)

                # when scroll start then use try method
                try:
                    if is_jobs_category and jobs_scrollable_container:
                        # Scroll the specific container for Jobs
                        self.driver.execute_script(f"arguments[0].scrollBy(0, {scroll_by});", jobs_scrollable_container)
                    else:
                        # Scroll the whole window for Posts/Others
                        self.driver.execute_script(f"window.scrollBy(0, {scroll_by});")
                        
                except WebDriverException as e:
                    # logging info when not scroll 
                    logging.error(f"Scrolling failed: {e}")
                    # then stop 
                    break

                # Add random delay between scroling 
                self._random_delay(1.5, 3.5)

                # add for output of scrolling after perfect  work 
                try:
                    if is_jobs_category and jobs_scrollable_container:
                        new_height = self.driver.execute_script("return arguments[0].scrollHeight", jobs_scrollable_container)
                        # For a container, we might also want to check scrollTop to see if we hit bottom
                        # But comparing scrollHeight change is safer for infinite loaders
                    else:
                        new_height = self.driver.execute_script("return document.body.scrollHeight")

                except WebDriverException as e:
                    #loging info if not scroll then show erroe 
                    logging.error(f"Error getting scroll height: {e}")
                    break

                # add now scroll posts to existing_post
                if new_height == last_height:
                    attempts += 1
                    # if posts not eqaual  to attempts time then show error 
                    if attempts % 5 == 0:
                        # logging warniing 
                        logging.warning(f"No new content loaded for {attempts} attempts.")
                    
                    self._random_delay(2, 4)
                
                # if all are in good work then go to else and show informtion 
                else:
                    scroll_count += 1
                    attempts = 0
                    last_height = new_height

                    # logging information about scrolling and counting 
                    logging.info(f"Scrolled {scroll_count}/{scroll_limit} times.")

            # logging info after all work show finished 
            logging.info("Scrolling finished.")

        # if not working then showw error 
        except Exception as e:
            # logging error 
            logging.error(f"Scrolling error: {e}")

