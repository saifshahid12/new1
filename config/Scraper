    # ---------------- HUMAN MIMICRY ----------------
    def _generate_bezier_curve(self, x0, y0, x1, y1, x2, y2, num_points=30):
        points = []
        for t in [i / (num_points - 1) for i in range(num_points)]:
            x = (1 - t)**2 * x0 + 2 * (1 - t) * t * x1 + t**2 * x2
            y = (1 - t)**2 * y0 + 2 * (1 - t) * t * y1 + t**2 * y2
            points.append((int(x), int(y)))
        return points

