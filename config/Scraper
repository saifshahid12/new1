            try:
                current_url = self.driver.current_url
                show_results = WebDriverWait(self.driver, 10).until(
                    EC.element_to_be_clickable((By.XPATH, "//button[contains(., 'Show') and contains(., 'result')]"))
                )
                self.driver.execute_script("arguments[0].click();", show_results)
                
                try:
                    WebDriverWait(self.driver, 15).until(lambda d: d.current_url != current_url)
                except: pass
                
                self._random_delay(3, 5)
                # Scroll top
                self.driver.execute_script("window.scrollTo(0, 0);")
                
            except Exception as e:
                logging.error(f"Failed to click Show results: {e}")
        
        except Exception as e:
            logging.error(f"Filter error: {e}")

    def _get_sort_text_for_category(self, category: str, sort_order: str) -> str:
        sort_mappings = {
            "Posts": {"latest": "Latest", "oldest": "Top match"},
            "Jobs": {"latest": "Most recent", "oldest": "Most relevant"},
            "People": {"latest": "Recently added", "oldest": "Most relevant"},
            "Companies": {"latest": "Most recent", "oldest": "Most relevant"}
        }
        cat_map = sort_mappings.get(category, sort_mappings["Posts"])
        return cat_map.get(sort_order.lower(), cat_map["latest"])
