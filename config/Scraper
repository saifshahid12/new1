    def human_like_scroll(self):
        """
        Simulates scrolling. 
        CRITICAL UPDATE: Handles the specific left-side scrollable container for Jobs.
        """
        try:
            scroll_limit = self.config['scraper_settings']['scroll_limit']
            max_attempts = self.config['scraper_settings'].get('max_scroll_attempts', 50)

            # Check if we are in Jobs mode
            is_jobs_category = self.category.lower() == "jobs"
            jobs_container = None

            if is_jobs_category:
                logging.info("Jobs category detected. Locating scrollable job list...")
                # XPaths for the scrollable left panel in Jobs view
                # The class usually contains 'jobs-search-results-list'
                job_list_selectors = [
                    "//div[contains(@class, 'jobs-search-results-list')]", 
                    "//div[contains(@class, 'jobs-search-results__list')]",
                    "//div[contains(@class, 'scaffold-layout__list')]",
                    "//div[contains(@class, 'jobs-search-results')]"
                ]
                
                for xpath in job_list_selectors:
                    try:
                        element = self.driver.find_element(By.XPATH, xpath)
                        if element.is_displayed():
                            jobs_container = element
                            logging.info(f"Jobs scrollable container found: {xpath}")
                            break
                    except:
                        continue
                
                if not jobs_container:
                    logging.warning("Could not find specific Job list container. Will try window scroll.")
            
            # Initial height check
            if jobs_container:
                last_height = self.driver.execute_script("return arguments[0].scrollHeight", jobs_container)
            else:
                last_height = self.driver.execute_script("return document.body.scrollHeight")

            scroll_count = 0
            attempts = 0

            logging.info(f"Starting scroll (limit: {scroll_limit})...")

            while scroll_count < scroll_limit and attempts < max_attempts:
                
                # Human behavior
                if random.random() < 0.3:
                    self._random_human_action()
                
                self._random_human_mouse_move()
                
                # Random scroll amount
                scroll_by = random.randint(300, 800)  # Smaller chunks for job list

                try:
                    if jobs_container:
                        # CRITICAL: Scroll the specific CONTAINER, not the window
                        self.driver.execute_script(f"arguments[0].scrollBy(0, {scroll_by});", jobs_container)
                        logging.debug("Scrolled job container.")
                    else:
                        # Normal Window Scroll
                        self.driver.execute_script(f"window.scrollBy(0, {scroll_by});")
                
                except Exception as e:
                    logging.error(f"Scroll command failed: {e}")
                    break

                self._random_delay(1.5, 3.0)

                # Check if new content loaded
                try:
                    if jobs_container:
                        new_height = self.driver.execute_script("return arguments[0].scrollHeight", jobs_container)
                    else:
                        new_height = self.driver.execute_script("return document.body.scrollHeight")
                except:
                    break

                if new_height == last_height:
                    attempts += 1
                    if attempts % 3 == 0:
                        logging.info("Waiting for content to load...")
                    if attempts >= 10:
                        logging.warning("Max scroll attempts reached without new content.")
                        break
                else:
                    attempts = 0
                    scroll_count += 1
                    last_height = new_height
                    logging.info(f"Scrolled {scroll_count}/{scroll_limit}")

            logging.info("Scrolling finished.")

        except Exception as e:
            logging.error(f"Scrolling error: {e}")

